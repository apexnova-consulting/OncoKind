# App (for Stripe redirects and password-reset emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Feature flags (OFF in production until clinical/legal approval)
FEATURE_FIRST_72_HOURS=0
FEATURE_ONCOKIND_FAMILY=0
NEXT_PUBLIC_FEATURE_FIRST_72_HOURS=0
NEXT_PUBLIC_FEATURE_ONCOKIND_FAMILY=0
FEATURE_COMPLETE_THE_PICTURE=0
FEATURE_ACCESS_AGENT=0
FEATURE_VOICE_CALL_FOR_ME=0
NEXT_PUBLIC_FEATURE_COMPLETE_THE_PICTURE=0
NEXT_PUBLIC_FEATURE_ACCESS_AGENT=0
NEXT_PUBLIC_FEATURE_VOICE_CALL_FOR_ME=0
FEATURE_AGENTS_KILL_SWITCH=0
FEATURE_VOICE_KILL_SWITCH=1
FEATURE_VOICE_PRODUCTION_CALLS=0
FEATURE_ACCESS_INCLUDE_UNVERIFIED=0
VOICE_BETA_ACCOUNT_IDS=
# Optional error logging
SENTRY_DSN=

# Stripe (set live price IDs from Dashboard → Products)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_CAREGIVER_MONTHLY=price_...  # Caregiver Pro $39/month
STRIPE_PRICE_ID_CAREGIVER_YEARLY=price_...   # Caregiver Pro $390/year
STRIPE_PRICE_ID_ADVOCATE_MONTHLY=price_...
STRIPE_PRICE_ID_ADVOCATE_YEARLY=price_...
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY=price_...
# Legacy fallbacks (used only if the v2 IDs above are unset)
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_YEARLY=price_...
STRIPE_PRICE_ID_ADVOCATE_MONTHLY=price_...
STRIPE_PRICE_ID_ADVOCATE_YEARLY=price_...
STRIPE_PRICE_ID_ENTERPRISE_UNLIMITED=price_...
STRIPE_PRICE_ID_ENTERPRISE_PER_SEAT=price_...

# Anthropic (Clarity engine)
ANTHROPIC_API_KEY=sk-ant-...

# Required for patient_reports encryption (32 bytes base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Advocacy & Financial Navigation
FINANCIAL_AID_CRON_SECRET=replace-me-with-a-long-random-string
FINANCIAL_AID_SCRAPER_MODE=live
# Optional local/dev override if you want Playwright to use a local Chrome/Chromium binary.
PLAYWRIGHT_EXECUTABLE_PATH=
# Optional custom UA for external funding sites.
FINANCIAL_AID_SCRAPER_USER_AGENT=

# Admin / check-in reminders
ADMIN_EMAILS=founder@example.com
CHECK_IN_CRON_SECRET=replace-me-with-a-long-random-string
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=OncoKind <hello@oncokind.com>

# E2E / Playwright
ENABLE_E2E_TEST_ROUTES=0
BASE_URL=http://localhost:3000
TEST_FREE_EMAIL=
TEST_FREE_PASS=
TEST_ADVOCATE_EMAIL=
TEST_ADVOCATE_PASS=
